server:
  port: 8080
  host: "127.0.0.1"
  api_key: ""
  cors_origins: []

storage:
  backend: "full"  # "full" (Redis+Qdrant+KuZu+DuckDB) | "lite" (SQLite+sqlite-vec)

  redis:
    url: "redis://localhost:6379"
    hot_ttl_hours: 24
    cache_ttl_hours: 6
    freq_ttl_days: 30

  qdrant:
    mode: "local"  # "local" (embedded) | "server"
    path: "~/.mimir/qdrant"
    collection_name: "l1_memories"

  kuzu:
    path: "~/.mimir/kuzu"

  duckdb:
    path: "~/.mimir/memories.db"

embedding:
  # "openai"   — any OpenAI-compatible /embeddings endpoint (Ollama included).
  #              Dense vectors only; a real network call every time.
  # "fastembed" — fully local, in-process (ONNX), no server/API key, no
  #              per-call network traffic. Produces dense + sparse (BM25)
  #              vectors, which is what unlocks Qdrant's native hybrid search
  #              below instead of DuckDB-BM25 + a hand-rolled RRF merge.
  #              First use downloads model weights once (anonymous, no user
  #              content sent) into fastembed_cache_dir.
  # "none"     — the default. Zero outbound calls, keyword-only recall.
  provider: "none"  # "openai" | "fastembed" | "none"
  base_url: "https://api.openai.com/v1"
  api_key: "${OPENAI_API_KEY}"
  model: "text-embedding-3-small"
  dimensions: 1536

  # fastembed only:
  fastembed_dense_model: "BAAI/bge-small-en-v1.5"
  fastembed_sparse_model: "Qdrant/bm25"
  fastembed_cache_dir: "~/.mimir/models"

llm:
  provider: "openai"  # "openai" (any OpenAI-compatible endpoint) | "vertex"
  base_url: "https://api.openai.com/v1"
  api_key: "${OPENAI_API_KEY}"
  model: "gpt-4o-mini"
  extraction_model: ""
  timeout_ms: 30000
  # Reasoning/thinking models bill their thinking against the SAME output
  # budget the answer has to fit in. Left on, a 2000-token budget can spend
  # 1900+ tokens thinking and truncate the real response mid-sentence — which
  # returns HTTP 200, so it fails silently. Every task this engine asks an LLM
  # to do is structured enumeration rather than reasoning, so 0 is the default.
  #   0  = thinking disabled
  #   >0 = explicit thinking budget in tokens
  #   <0 = omit the setting and let the model decide
  # Vertex only; on OpenAI-compatible endpoints truncation is detected and
  # logged either way. Also settable as MIMIR_THINKING_BUDGET.
  thinking_budget: 0

pipeline:
  l1_every_n_turns: 5
  l1_idle_timeout_seconds: 600
  l2_every_n_memories: 20
  l3_every_n_memories: 50
  enable_warmup: true

recall:
  strategy: "hybrid"  # "hybrid" | "vector" | "keyword" | "graph"
  max_results: 10
  recall_threshold: 0.30
  cache_threshold: 0.92
  max_context_chars: 6000
  weights:
    semantic: 0.45
    frequency: 0.20
    recency: 0.25
    graph: 0.10
  # exp(-decay_rate * age_days). 0.05 halves a fact's recency signal in about
  # 14 days, which is what you want for an assistant where recent context
  # genuinely matters more. Set to 0.0 to switch decay off — worth doing for
  # multi-session evaluation sets where every session is equally relevant
  # (measured +6.3 points on personamem/32k, p=0.012).
  decay_rate: 0.05

extraction:
  # A dense 32k-token session legitimately yields 26-32 atomic facts, so 20
  # silently discarded the tail. Raised once an extraction truncation bug was
  # fixed — before that, sessions were landing one fact each and this cap had
  # never bound on anything.
  max_memories_per_session: 50
  min_priority: 50
  enable_dedup: true
  enable_entity_extraction: true

capture:
  l0_retention_days: 0
  exclude_agents: []

# Pro only:
pii:
  enabled: false
  types: ["EMAIL", "PHONE", "SSN", "CREDIT_CARD"]
  strategy: "mask"

compliance:
  audit_log_enabled: false
  data_residency: "local"
